# Copie para .env (nunca versione o .env). Os segredos do Worker são cadastrados com `wrangler secret put`.
OPENROUTER_API_KEY=       # chave só deste bot, com teto de gasto
TELEGRAM_BOT_TOKEN=       # do @BotFather
WEBHOOK_SECRET=           # openssl rand -hex 24
ADMIN_TOKEN=              # openssl rand -hex 24 (painel e /admin/*)
ELEVENLABS_API_KEY=       # opcional: voz (entrada e botão Ouvir)
